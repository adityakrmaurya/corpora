flowchart TB
  uploadController["<b>UploadController</b><br/><i>Spring WebFlux Controller</i><br/>Reactive multipart upload, streams to MinIO without buffering"]
  validatorClient["<b>RequestValidatorClient</b><br/><i>gRPC stub</i>"]
  authzClient["<b>AuthorizationClient</b><br/><i>gRPC stub</i>"]
  uploadService["<b>UploadService</b><br/><i>Domain service</i><br/>Owns the Upload aggregate"]
  outbox["<b>TransactionalOutbox</b><br/><i>Spring Data JPA + poller</i>"]
  kafkaProducer["<b>DocumentUploadedProducer</b><br/><i>spring-kafka</i>"]
  ingestionSchema[("ingestion-db<br/><i>dedicated Postgres instance</i>")]

  minio["<b>MinIO</b><br/><i>Object Storage</i>"]
  validatorSvc["<b>Request Validator Service</b><br/><i>Container</i>"]
  authzSvc["<b>Authorization &amp; Identity-Context</b><br/><i>Container</i>"]
  kafka{{"<b>Kafka</b><br/><i>document.uploaded.v1</i>"}}

  uploadController -->|"stream raw bytes (S3 API)"| minio
  uploadController -->|"validate before commit"| validatorClient
  validatorClient -->|"gRPC"| validatorSvc
  uploadController -->|"authorize upload"| authzClient
  authzClient -->|"gRPC"| authzSvc
  uploadController -->|"on success"| uploadService
  uploadService --> ingestionSchema
  uploadService -->|"same-transaction event write"| outbox
  outbox -->|"relay"| kafkaProducer
  kafkaProducer -->|"publish"| kafka

  classDef entrypoint fill:#1e293b,stroke:#0f172a,color:#ffffff
  classDef domain fill:#0d9488,stroke:#0f766e,color:#ffffff
  classDef stub fill:#5eead4,stroke:#0f766e,color:#0f172a,stroke-dasharray:3 2
  classDef db fill:#334155,stroke:#1e293b,color:#ffffff
  classDef queue fill:#ea580c,stroke:#c2410c,color:#ffffff
  classDef external fill:#64748b,stroke:#475569,color:#ffffff

  class uploadController entrypoint
  class uploadService,outbox,kafkaProducer domain
  class validatorClient,authzClient stub
  class ingestionSchema db
  class kafka queue
  class minio,validatorSvc,authzSvc external

  linkStyle default color:#1e293b,font-weight:500;
