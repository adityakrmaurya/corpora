flowchart TB
  chatEntrypoint["<b>ChatStreamEndpoint</b><br/><i>gRPC server-streaming</i><br/>Entry point from the Gateway"]
  rewriter["<b>QueryRewriter</b><br/><i>Domain service</i><br/>Pronoun/ellipsis resolution, decomposition"]
  intentClassifier["<b>IntentClassifier</b><br/><i>Domain service</i><br/>factual vs summarization vs comparison"]
  filterHintExtractor["<b>FilterHintExtractor</b><br/><i>Domain service</i><br/>Untrusted, narrows only"]
  orchestrator["<b>AnswerOrchestrator</b><br/><i>Saga-style coordinator</i><br/>Owns the total gRPC deadline budget"]
  deadlineManager["<b>DeadlineManager</b><br/><i>gRPC deadline propagation</i>"]
  retrievalClient["<b>RetrievalClient</b><br/><i>gRPC stub</i>"]
  rerankerClient["<b>RerankerClient</b><br/><i>gRPC stub</i>"]
  formatterClient["<b>ResponseFormatterClient</b><br/><i>gRPC bidi stub</i>"]
  auditPublisher["<b>AsyncAuditPublisher</b><br/><i>Kafka producer, fire-and-forget</i><br/>Never blocks the response"]

  retrieval["<b>Retrieval Service</b><br/><i>Container</i>"]
  reranker["<b>Reranker Service</b><br/><i>Container</i>"]
  responseFormatter["<b>Response Formatter</b><br/><i>Container</i>"]
  kafka{{"<b>Kafka</b><br/><i>read-side audit events</i>"}}

  chatEntrypoint -->|"1 . rewrite"| rewriter
  chatEntrypoint -->|"2 . classify intent"| intentClassifier
  chatEntrypoint -->|"3 . extract filter hints"| filterHintExtractor
  chatEntrypoint -->|"4 . orchestrate"| orchestrator
  chatEntrypoint -.->|"fire-and-forget"| auditPublisher

  orchestrator -->|"enforces budget"| deadlineManager
  orchestrator -->|"FindCandidates"| retrievalClient
  orchestrator -->|"Rerank"| rerankerClient
  orchestrator -->|"FormatStream (bidi)"| formatterClient

  retrievalClient -->|"gRPC"| retrieval
  rerankerClient -->|"gRPC"| reranker
  formatterClient -->|"gRPC"| responseFormatter
  auditPublisher -->|"publish"| kafka

  classDef entrypoint fill:#1e293b,stroke:#0f172a,color:#ffffff
  classDef domain fill:#7c3aed,stroke:#6d28d9,color:#ffffff
  classDef async fill:#7c3aed,stroke:#6d28d9,color:#ffffff,stroke-dasharray:4 3
  classDef stub fill:#ddd6fe,stroke:#6d28d9,color:#312e81,stroke-dasharray:3 2
  classDef queue fill:#ea580c,stroke:#c2410c,color:#ffffff
  classDef external fill:#64748b,stroke:#475569,color:#ffffff

  class chatEntrypoint entrypoint
  class rewriter,intentClassifier,filterHintExtractor,orchestrator,deadlineManager domain
  class auditPublisher async
  class retrievalClient,rerankerClient,formatterClient stub
  class kafka queue
  class retrieval,reranker,responseFormatter external

  linkStyle default color:#1e293b,font-weight:500;
