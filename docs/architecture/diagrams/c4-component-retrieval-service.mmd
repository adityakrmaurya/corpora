flowchart TB
  findCandidates["<b>FindCandidatesEndpoint</b><br/><i>gRPC unary</i><br/>Entry point from Query Processor"]
  queryEmbedder["<b>QueryEmbedder</b><br/><i>Spring AI EmbeddingModel</i>"]
  aclFilterBuilder["⚠ <b>AccessControlFilterExpressionBuilder</b><br/><i>HIGHEST RISK LOGIC</i><br/>Builds the mandatory ACL Filter.Expression"]
  hintMerger["<b>UserHintMerger</b><br/><i>Domain service</i><br/>AND-merges the narrowing hint, cannot widen"]
  similaritySearch["<b>SimilaritySearchService</b><br/><i>PgVectorStore.similaritySearch</i>"]
  pgvectorReader[("PGVector (read-only)<br/><i>embedding-db</i>")]
  auditPublisher["<b>AsyncAuditPublisher</b><br/><i>Kafka producer, fire-and-forget</i>"]

  ollama["<b>Ollama / active provider</b><br/><i>Container</i>"]
  kafka{{"<b>Kafka</b><br/><i>ChunksRetrieved</i>"}}

  findCandidates -->|"1 . embed query"| queryEmbedder
  queryEmbedder -->|"gRPC/REST"| ollama
  findCandidates -->|"2 . build mandatory ACL filter"| aclFilterBuilder
  aclFilterBuilder -->|"3 . AND-merge narrowing hint"| hintMerger
  hintMerger -->|"4 . execute filtered search"| similaritySearch
  similaritySearch -->|"SELECT ... WHERE filter"| pgvectorReader
  similaritySearch -.->|"5 . fire-and-forget"| auditPublisher
  auditPublisher -->|"publish"| kafka

  classDef entrypoint fill:#1e293b,stroke:#0f172a,color:#ffffff
  classDef domain fill:#7c3aed,stroke:#6d28d9,color:#ffffff
  classDef risk fill:#b91c1c,stroke:#7f1d1d,color:#ffffff,stroke-width:2px
  classDef async fill:#7c3aed,stroke:#6d28d9,color:#ffffff,stroke-dasharray:4 3
  classDef db fill:#334155,stroke:#1e293b,color:#ffffff
  classDef queue fill:#ea580c,stroke:#c2410c,color:#ffffff
  classDef external fill:#64748b,stroke:#475569,color:#ffffff

  class findCandidates entrypoint
  class queryEmbedder,hintMerger,similaritySearch domain
  class aclFilterBuilder risk
  class auditPublisher async
  class pgvectorReader db
  class kafka queue
  class ollama external

  linkStyle default color:#1e293b,font-weight:500;
