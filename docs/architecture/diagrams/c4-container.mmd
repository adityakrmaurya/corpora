%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#0d9488",
    "primaryTextColor": "#ffffff",
    "primaryBorderColor": "#0f766e",
    "lineColor": "#94a3b8",
    "secondaryColor": "#e2e8f0"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 35,
    "rankSpacing": 70,
    "wrappingWidth": 220,
    "padding": 10,
    "diagramPadding": 24
  },
  "htmlLabels": true
