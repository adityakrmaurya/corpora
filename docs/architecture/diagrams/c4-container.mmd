flowchart TB
  user(["<b>Knowledge Worker / Admin</b><br/><i>Person</i>"])
  gateway["<b>API Gateway</b><br/><i>Spring Cloud Gateway</i><br/>Edge JWT validation, routing, rate limiting"]

  authz["<b>Authorization &amp; Identity-Context</b><br/><i>Spring Boot / gRPC</i><br/><i>own Postgres instance</i>"]
  validator["<b>Request Validator</b><br/><i>Spring Boot / gRPC</i><br/><i>own Postgres instance</i>"]
  ingestion["<b>Ingestion Service</b><br/><i>Spring Boot / WebFlux</i><br/><i>own Postgres instance</i>"]
  parsing["<b>Parsing Service</b><br/><i>Spring Boot</i><br/><i>own Postgres instance</i>"]
  chunking["<b>Chunking Service</b><br/><i>Spring Boot</i><br/><i>own Postgres instance</i>"]
  embedding["<b>Embedding Service</b><br/><i>Spring Boot / Spring AI</i>"]
  catalog["<b>Document Catalog &amp; Lifecycle</b><br/><i>Spring Boot</i><br/><i>own Postgres instance</i>"]
  audit["<b>Audit Service</b><br/><i>Spring Boot</i><br/><i>own Postgres instance</i>"]

  pgEmbedding[("embedding-db<br/><i>PostgreSQL + pgvector</i>")]

  kafka{{"<b>Kafka</b><br/><i>KRaft</i>"}}
  minio[("<b>MinIO</b><br/><i>Object Storage</i>")]

  queryProcessor["<b>Query Processor</b><br/><i>Spring Boot / gRPC</i>"]
  retrieval["<b>Retrieval Service</b><br/><i>Spring AI / gRPC</i>"]
  reranker["<b>Reranker Service</b><br/><i>DJL / gRPC</i>"]
  responseFormatter["<b>Response Formatter</b><br/><i>Spring Boot / gRPC</i>"]
  llmRouter["<b>LLM Router</b><br/><i>Spring AI / gRPC</i><br/><i>own Postgres instance</i>"]

  keycloak["<b>Keycloak</b><br/><i>External System</i>"]
  ollama["<b>Ollama / Cloud LLMs</b><br/><i>External System</i>"]
  doclingServe["<b>Docling Serve</b><br/><i>External System</i>"]
  otel["<b>Observability Stack</b><br/><i>External System</i>"]

  user --> gateway
  gateway -->|"upload"| ingestion
  gateway -->|"status/list/delete"| catalog
  gateway -->|"chat"| queryProcessor
  gateway -->|"JWKS"| keycloak

  ingestion --> validator
  ingestion --> authz
  catalog --> authz

  ingestion --> kafka
  validator --> kafka
  parsing --> kafka
  chunking --> kafka
  embedding --> kafka
  catalog --> kafka
  audit --> kafka

  kafka ~~~ parsing
  kafka ~~~ chunking
  kafka ~~~ embedding
  kafka ~~~ audit

  parsing -->|"convert"| doclingServe
  chunking -->|"chunk"| doclingServe
  embedding -->|"embed"| ollama
  embedding --> pgEmbedding

  ingestion --> minio
  parsing --> minio
  chunking --> minio

  queryProcessor --> retrieval
  queryProcessor --> reranker
  queryProcessor --> responseFormatter
  responseFormatter --> llmRouter
  retrieval ==>|"read-only (cross-service exception)"| pgEmbedding
  retrieval -->|"embed query"| ollama
  llmRouter -->|"chat completion"| ollama

  gateway --> otel
  ingestion --> otel
  queryProcessor --> otel

  classDef person fill:#1e3a5f,stroke:#0f2942,color:#ffffff
  classDef gateway fill:#1e293b,stroke:#0f172a,color:#ffffff
  classDef writeSvc fill:#0d9488,stroke:#0f766e,color:#ffffff
  classDef readSvc fill:#7c3aed,stroke:#6d28d9,color:#ffffff
  classDef db fill:#334155,stroke:#1e293b,color:#ffffff
  classDef queue fill:#ea580c,stroke:#c2410c,color:#ffffff
  classDef external fill:#64748b,stroke:#475569,color:#ffffff

  class user person
  class gateway gateway
  class authz,validator,ingestion,parsing,chunking,embedding,catalog,audit writeSvc
  class queryProcessor,retrieval,reranker,responseFormatter,llmRouter readSvc
  class pgEmbedding,minio db
  class kafka queue
  class keycloak,ollama,doclingServe,otel external

  linkStyle default color:#1e293b,font-weight:500;
