flowchart TB
  endUser(["<b>Knowledge Worker</b><br/><i>Person</i><br/>Uploads documents and asks questions against the corpus"])
  admin(["<b>Corpus Administrator</b><br/><i>Person</i><br/>Manages corpora, document ACLs, and tenant/routing policy"])
  complianceOfficer(["<b>Compliance / Audit Officer</b><br/><i>Person</i><br/>Reviews the audit trail: who accessed what, and why"])

  corpora["<b>Corpora</b><br/><i>Software System</i><br/>Self-hosted enterprise document RAG platform — ingest, index, and chat over documents with per-document access control"]

  idp["<b>Keycloak</b><br/><i>OIDC Identity Provider</i><br/>Source of truth for users, groups, tenants"]
  llmProviders["<b>LLM / Embedding Providers</b><br/><i>External System</i><br/>Ollama (self-hosted default) or opt-in Azure OpenAI / AWS Bedrock / Anthropic"]
  doclingServe["<b>Docling Serve</b><br/><i>External System</i><br/>Vendored document-understanding engine — official container, not owned code"]
  objectStorage["<b>MinIO</b><br/><i>External System</i><br/>Self-hosted S3-compatible object storage"]
  observability["<b>Observability Stack</b><br/><i>External System</i><br/>Prometheus / Grafana / Tempo / Loki"]

  endUser -->|"Uploads docs, asks questions (HTTPS)"| corpora
  admin -->|"Manages corpora, ACLs, routing policy (HTTPS)"| corpora
  complianceOfficer -->|"Queries audit trail (HTTPS)"| corpora

  corpora -->|"Validates JWTs, resolves claims (OIDC/JWKS)"| idp
  corpora -->|"Chat + embedding calls (REST)"| llmProviders
  corpora -->|"Document conversion + chunking (REST)"| doclingServe
  corpora -->|"Raw upload + artifact storage (S3 API)"| objectStorage
  corpora -->|"Metrics / logs / traces (OTLP)"| observability

  classDef person fill:#1e3a5f,stroke:#0f2942,color:#ffffff
  classDef system fill:#2563eb,stroke:#1d4ed8,color:#ffffff
  classDef external fill:#64748b,stroke:#475569,color:#ffffff

  class endUser,admin,complianceOfficer person
  class corpora system
  class idp,llmProviders,doclingServe,objectStorage,observability external

  linkStyle default color:#1e293b,font-weight:500;
